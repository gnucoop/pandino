#####################################
# Security
#####################################
ENCRYPTION_KEY="{private}"
ADMIN_USERNAME="{private}"
ADMIN_PASSWORD_HASH="{private}"

#####################################
# Database (PostgreSQL)
#####################################
PGUSER="{private}"
PGPWD="{private}"
PGHOST="{private}"
PGDB="{private}"
PGPORT="5432"
MAUI_SCHEMA="public"

#####################################
# External Services
#####################################

# URL of the Auth Gateway used for external identity validation.
# Example (local development):
# http://localhost:3000/validate
AUTH_GATEWAY_URL="http://localhost:3000/validate"

# Base URL for a local Ollama server (used when provider is Ollama).
OLLAMA_BASE_URL="http://localhost:11434"

#####################################
# Default Models & Providers
#####################################
DATACHAT_MODEL="zai-glm-5-3-flash"
DATACHAT_PROVIDER="Mistral"

PROMPT_MODEL="Qwen/Qwen2.5-72B-Instruct"
PROMPT_PROVIDER="Deepinfra"

COMPLETION_MODEL="mistralai/Mistral-Small-3.2-24B-Instruct-2506"
COMPLETION_MODEL_PROVIDER="Deepinfra"

COMPLETION_MODEL_AGENT_CHAT="mistralai/Mistral-Small-24B-Instruct-2501"

COMPLETION_EMBEDDING_MODEL="bge-m3:567m-fp16"
COMPLETION_EMBEDDING_MODEL_PROVIDER="Ollama"

AUDIO_MODEL="mistralai/Mistral-Small-3.2-24B-Instruct-2506"
AUDIO_PROVIDER="Deepinfra"

ASR_MODEL="openai/whisper-large-v3"
ASR_PROVIDER="Deepinfra"
# Required only when ASR_PROVIDER="Mistral": governed per-minute audio rate
# (USD) used to resolve Mistral ASR cost. No default - unset here so cost
# resolution fails explicitly rather than silently defaulting to 0.
# ASR_MISTRAL_PRICE_PER_MINUTE_USD="0.003"

VISION_MODEL="google/gemma-3-4b-it"
VISION_PROVIDER="Deepinfra"

COMPARE_DOCS_MODEL="google/gemma-3-4b-it"
COMPARE_DOCS_PROVIDER="Google"

#####################################
# Token Costs
#####################################
DATACHAT_TOKEN_COST=1
COMPLETION_TOKEN_COST=1
PROMPT_TOKEN_COST=1
AUDIO_FORM_TOKEN_COST=1
COMPARE_DOCS_TOKEN_COST=1
INTERVIEWER_TOKEN_COST=1
ANALYST_TOKEN_COST=1

#####################################
# API Keys
#####################################
OPENAI_API_KEY="{private}"
MISTRAL_API_KEY="{private}"
GROQ_API_KEY="{private}"
GOOGLE_API_KEY="{private}"
ANTHROPIC_API_KEY="{private}"
DEEPSEEK_API_KEY="{private}"
DEEPINFRA_API_KEY="{private}"
OPENROUTER_API_KEY="{private}"
TOGETHER_API_KEY="{private}"
PANDASAI_API_KEY="{private}"

#####################################
# LangChain
#####################################
LANGCHAIN_TRACING_V2="true"
LANGCHAIN_PROJECT="{private}"
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY="{private}"

#####################################
# Stripe
#####################################
STRIPE_SK_KEY="{private}"

#####################################
# Vector Store
#####################################
# Legacy / not wired into any active flow today (PineconeStore, see
# system_design.md "Limitazioni architetturali note e accettate").
# Candidate for removal once the store itself is formally dropped.
PINECONE_API_KEY="{private}"

#####################################
# RAG Retrieval Parameters
#####################################
RAG_TOP_K=3
RAG_MIN_SIM=0.5
RAG_DEFAULT_NAMESPACE="{private}"

#####################################
# Logging
#####################################
# Root log level for the operational channel. Keep at WARNING: INFO is not
# yet safe to enable pending a sensitive-content audit of existing INFO logs.
LOG_LEVEL="WARNING"

# Destination file of the structured agent-run audit channel (JSONL).
AGENT_RUNS_LOG_PATH="logs/agent_runs.log"

#####################################
# ENGINES
#####################################
DATACHAT_ENGINE="smolagents"
DATACHAT_MAX_STEPS=50
DATACHAT_RATE_LIMIT_PER_MIN=0
DATACHAT_SESSION_TTL_MIN=60
DATACHAT_LOG_LEVEL="INFO"
DATACHAT_PLOTS_DIR="/tmp/datachat_plots"

#####################################
# DataChat SQL (optional)
#####################################
# Off by default. When on, the DataChat agent gains the read-only sql_engine
# tool and the database schema in its prompt. The analysis interviewer requires it.
DATACHAT_SQL_ENABLED="false"

# Always a dedicated database — these never fall back to the PG* application
# database, which the agent reaches through its own tools. All four are
# REQUIRED when DATACHAT_SQL_ENABLED is true; without them the SQL datasource is
# disabled (and an error logged), while the rest of the app still starts.
DATACHAT_DB_HOST=""
DATACHAT_DB_NAME=""
DATACHAT_DB_USER=""
DATACHAT_DB_PASSWORD="{private}"
DATACHAT_DB_PORT="5432"
DATACHAT_DB_SCHEMA="public"

# Safety limits
DATACHAT_SQL_MAX_ROWS=200
DATACHAT_SQL_MAX_COLUMNS=400
DATACHAT_SQL_MAX_CELL_CHARS=300
DATACHAT_SQL_STATEMENT_TIMEOUT_MS=60000

# Whether the Datachat agent may see views and materialized views.
DATACHAT_SQL_INCLUDE_VIEWS="true"

# Schema snapshot. The schema is reflected once and rendered into the agent's
# system prompt, so the agent never spends turns discovering it. The snapshot is
# shared process-wide and rebuilt when older than the TTL; set 0 to rebuild on
# every agent creation. If the rendered schema exceeds MAX_CHARS it degrades one
# tier at a time — first the example values, then the column lists — which keeps
# a very large schema from silently inflating every request. INCLUDE_FKS adds one
# foreign-key line per table, which is what lets the agent join correctly without
# guessing.
DATACHAT_SQL_SCHEMA_TTL_S=3600
DATACHAT_SQL_SCHEMA_MAX_CHARS=100000
DATACHAT_SQL_SCHEMA_INCLUDE_FKS="true"

# Identifier case repair. PostgreSQL folds unquoted names to lowercase, so an
# agent writing `FROM Trasporti` against a mixed-case schema gets
# `relation "trasporti" does not exist`. With this on, bare identifiers in the
# agent's SQL are rewritten to their real, quoted spelling before the query is
# validated and run. Only names that are unambiguous are touched: a schema
# holding both `Anno` and `anno` leaves that one for the agent to quote itself.
DATACHAT_SQL_QUOTE_IDENTIFIERS="true"

# Value profiling. Names and types alone do not say how a column is written, so
# the agent has to guess whether a period column holds "07" or "202607", or
# whether a customer name lives in the code column or the label column — and a
# wrong guess returns zero rows rather than an error. Each relation is sampled
# once, with a single bounded "SELECT ... LIMIT SAMPLE_ROWS", and up to
# MAX_VALUES distinct values per column are rendered into the schema as examples.
# Only text, boolean and date-like columns are sampled: a measure has no spelling
# to get wrong. The sample is not the column's domain, and the prompt says so.
# Turn PROFILE_VALUES off to go back to names and types only.
DATACHAT_SQL_SCHEMA_PROFILE_VALUES="true"
DATACHAT_SQL_SCHEMA_PROFILE_SAMPLE_ROWS=50
DATACHAT_SQL_SCHEMA_PROFILE_MAX_VALUES=3
DATACHAT_SQL_SCHEMA_PROFILE_MAX_VALUE_CHARS=32

# Optional relation scoping — one shared namespace covering tables, views and
# materialized views alike. The allowlist wins when non-empty; otherwise the
# denylist applies. Both are empty by default.
DATACHAT_SQL_ALLOWED_TABLES=""
DATACHAT_SQL_DENIED_TABLES=""

#####################################
# Analysis interviewer
#####################################
# Interviews the user about the analysis they want and produces an analysis
# brief for approval. Reads the DataChat SQL datasource (DATACHAT_SQL_ENABLED
# must be on). Provider and model default to DATACHAT_PROVIDER / DATACHAT_MODEL.
INTERVIEWER_PROVIDER="Mistral"
INTERVIEWER_MODEL="zai-glm-5-3-flash"
# Agent steps per turn (queries, findings, the answer itself).
INTERVIEWER_MAX_STEPS=20
# Turns per round before the agent is told to propose a brief draft (only once
# the minimum interview below is met). A rejected draft opens a new round.
INTERVIEWER_MAX_TURNS=15
# Data findings the agent may keep across turns.
INTERVIEWER_MAX_NOTES=30
# Questions asked and answered, about the goal and the data included, before a
# brief draft is accepted; the user's answer to the opening goal question counts.
# Clamped to 4..10.
INTERVIEWER_MIN_QUESTIONS=4
INTERVIEWER_LOG_LEVEL="INFO"

#####################################
# Data analyst
#####################################
# Runs an approved analysis brief and writes an HTML report. Started by the
# interviewer when a brief is approved, or by /start-analysis. Reads the DataChat
# SQL datasource (DATACHAT_SQL_ENABLED must be on). Provider and model default
# to DATACHAT_PROVIDER / DATACHAT_MODEL; the report agent defaults to them too.
ANALYST_PROVIDER="Mistral"
ANALYST_MODEL="zai-glm-5-3-flash"
ANALYST_REPORT_PROVIDER="Mistral"
ANALYST_REPORT_MODEL="zai-glm-5-3-flash"
# The planner and report agents use ANALYST_REPORT_*, the task and chart agents
# ANALYST_*. Agent steps for planning, per sub-task, for the charts, for the report.
ANALYST_PLAN_MAX_STEPS=20
# Agent steps per sub-task, and for writing the report.
ANALYST_TASK_MAX_STEPS=20
ANALYST_CHART_MAX_STEPS=20
ANALYST_REPORT_MAX_STEPS=20
# Further attempts at a failed sub-task. Clamped to 0..3.
ANALYST_TASK_RETRIES=2
# Exploration tasks the planner may add to the brief's own (0 turns exploration
# off), and notable facts the task agents may record per run.
ANALYST_MAX_EXTRA_TASKS=5
ANALYST_MAX_INSIGHTS=12
# Rows sql_engine returns into the agent's context (also capped by
# DATACHAT_SQL_MAX_ROWS), and rows load_dataset loads into a DataFrame.
ANALYST_SQL_MAX_ROWS=200
ANALYST_DATASET_MAX_ROWS=100000
# Size of one saved sub-task output (JSON characters), and of one output value
# as the report agent reads it.
ANALYST_OUTPUT_MAX_CHARS=30000
ANALYST_PREVIEW_MAX_CHARS=3000
# Charts per report, and data points per chart.
ANALYST_MAX_CHARTS=20
ANALYST_CHART_MAX_POINTS=500
