#####################################
# Security
#####################################
ENCRYPTION_KEY= "{private}" #pg

#####################################
# Database (PostgreSQL)
#####################################
PGUSER="{private}"
PGPWD="{private}"
PGHOST="{private}"
PGDB="{private}"

#####################################
# Default Models & Providers
#####################################
DATACHAT_MODEL="Qwen/Qwen2.5-Coder-32B-Instruct"
DATACHAT_PROVIDER="Deepinfra"

PROMPT_MODEL="Qwen/Qwen2.5-72B-Instruct"
PROMPT_PROVIDER="Deepinfra"

COMPLETION_MODEL="google/gemma-3-4b-it"
COMPLETION_MODEL_PROVIDER="Deepinfra"

COMPLETION_EMBEDDING_MODEL="intfloat/multilingual-e5-large-instruct"
COMPLETION_EMBEDDING_MODEL_PROVIDER="Deepinfra"

AUDIO_MODEL="google/gemma-3-4b-it"
AUDIO_PROVIDER="Deepinfra"

WHISPER_MODEL="openai/whisper-large-v3"

VISION_PROVIDER="Deepinfra"
VISION_MODEL="google/gemma-3-4b-it"

#####################################
# Token Costs
#####################################
DATACHAT_TOKEN_COST=1
COMPLETION_TOKEN_COST=1
PROMPT_TOKEN_COST=1
AUDIO_FORM_TOKEN_COST=1

#####################################
# API Keys
#####################################
OPENAI_API_KEY="{private}"
MISTRAL_API_KEY="{private}"
GROQ_API_KEY="{private}"
GOOGLE_API_KEY="{private}"
ANTHROPIC_API_KEY="{private}"
DEEPSEEK_API_KEY="{private}"
DEEPINFRA_API_KEY="{private}"
PANDASAI_API_KEY="{private}"

#####################################
# LangChain
#####################################
LANGCHAIN_TRACING_V2="true"
LANGCHAIN_PROJECT="{private}"
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY="{private}"

#####################################
# Stripe
#####################################
STRIPE_SK_KEY="{private}"

#####################################
# Vector Store
#####################################
PINECONE_API_KEY="{private}"
