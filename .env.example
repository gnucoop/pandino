#####################################
# Security
#####################################
ENCRYPTION_KEY="{private}"

ADMIN_USERNAME="{private}"
ADMIN_PASSWORD_HASH="{private}"

#####################################
# Database (PostgreSQL)
#####################################
PGUSER="{private}"
PGPWD="{private}"
PGHOST="{private}"
PGDB="{private}"
PGPORT="5432"
MAUI_SCHEMA="public"

#####################################
# External Services
#####################################

# URL of the Auth Gateway used for external identity validation.
# Example (local development):
# http://localhost:3000/validate
AUTH_GATEWAY_URL="http://localhost:3000/validate"

# Base URL for a local Ollama server (used when provider is Ollama).
OLLAMA_BASE_URL="http://localhost:11434"

#####################################
# Default Models & Providers
#####################################
DATACHAT_MODEL="Qwen/Qwen2.5-Coder-32B-Instruct"
DATACHAT_PROVIDER="Deepinfra"

PROMPT_MODEL="Qwen/Qwen2.5-72B-Instruct"
PROMPT_PROVIDER="Deepinfra"

COMPLETION_MODEL="google/gemma-3-4b-it"
COMPLETION_MODEL_PROVIDER="Deepinfra"

COMPLETION_MODEL_AGENT_CHAT="mistralai/Mistral-Small-3.2-24B-Instruct-2506"

COMPLETION_EMBEDDING_MODEL="BAAI/bge-m3"
COMPLETION_EMBEDDING_MODEL_PROVIDER="Deepinfra"

AUDIO_MODEL="google/gemma-3-4b-it"
AUDIO_PROVIDER="Deepinfra"

ASR_MODEL="openai/whisper-large-v3"
ASR_PROVIDER="Deepinfra"

VISION_PROVIDER="Deepinfra"
VISION_MODEL="google/gemma-3-4b-it"

COMPARE_DOCS_MODEL="google/gemma-3-4b-it"
COMPARE_DOCS_PROVIDER="Google"

#####################################
# Token Costs
#####################################
DATACHAT_TOKEN_COST=1
COMPLETION_TOKEN_COST=1
PROMPT_TOKEN_COST=1
AUDIO_FORM_TOKEN_COST=1
COMPARE_DOCS_TOKEN_COST=1

#####################################
# API Keys
#####################################
OPENAI_API_KEY="{private}"
MISTRAL_API_KEY="{private}"
GROQ_API_KEY="{private}"
GOOGLE_API_KEY="{private}"
ANTHROPIC_API_KEY="{private}"
DEEPSEEK_API_KEY="{private}"
DEEPINFRA_API_KEY="{private}"
OPENROUTER_API_KEY="{private}"
TOGETHER_API_KEY="{private}"
PANDASAI_API_KEY="{private}"

#####################################
# LangChain
#####################################
LANGCHAIN_TRACING_V2="true"
LANGCHAIN_PROJECT="{private}"
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY="{private}"

#####################################
# Stripe
#####################################
STRIPE_SK_KEY="{private}"

#####################################
# Vector Store
#####################################
# Legacy / not wired into any active flow today (PineconeStore, see
# system_design.md "Limitazioni architetturali note e accettate").
# Candidate for removal once the store itself is formally dropped.
PINECONE_API_KEY="{private}"

#####################################
# RAG Retrieval Parameters
#####################################
RAG_TOP_K=3
RAG_MIN_SIM=0.5
RAG_DEFAULT_NAMESPACE="{private}"

#####################################
# ENGINES
#####################################
DATACHAT_ENGINE="smolagents"
DATACHAT_MAX_STEPS=12
DATACHAT_RATE_LIMIT_PER_MIN=0
DATACHAT_SESSION_TTL_MIN=60
DATACHAT_LOG_LEVEL="INFO"
DATACHAT_PLOTS_DIR="/tmp/datachat_plots"
